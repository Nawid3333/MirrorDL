<Project>
  <!-- Shared by all projects: shown in the file properties of the programs. -->
  <PropertyGroup>
    <!-- For local builds. A release build gets the version of its git tag (v1.2.3 -> 1.2.3)
         from build.ps1 -Version, which release.yml passes: the tag is the only place a
         version is written down, so there is no version-bump commit. -->
    <Version>0.0.0-dev</Version>
    <Authors>Nawid Salehie</Authors>
    <Company>Nawid Salehie</Company>
    <Product>MirrorDL</Product>
    <Copyright>Copyright (C) 2026 Nawid Salehie</Copyright>
    <Description>Downloads files from several mirrors at once, after checking that they serve the same file.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Nawid3333/MirrorDL</RepositoryUrl>
  </PropertyGroup>
</Project>
