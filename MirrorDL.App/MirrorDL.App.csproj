<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MirrorDL.App</RootNamespace>
    <AssemblyName>MirrorDL</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../assets/mirrordl.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Without it, publishing leaves out the compiled XAML and MirrorDL.pri, and the app crashes at start. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Brings the Windows App SDK runtime along, so nothing has to be installed. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Lets GitHub's dependency graph read the packages on Linux (it only restores, never builds
         there), so Dependabot alerts cover the Windows App SDK too. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MirrorDL.Core\MirrorDL.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\assets\mirrordl.ico" Link="mirrordl.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\assets\logo-64.png" Link="logo-64.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
